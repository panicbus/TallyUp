VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional locally (defaults to http://localhost:3000). Required in
# production — the deployed Render URL, e.g. https://tallyup-api.onrender.com
VITE_API_URL=

# Optional everywhere. Analytics only runs in production builds, and
# leaving the key blank turns it into a no-op. Production uses the
# Panicbus Studios project token (PostHog: Settings -> Project -> Project
# token). Leave VITE_POSTHOG_HOST blank: the app then sends to /pbr, which
# vercel.json proxies to PostHog's US servers (docs/adr/0006).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
