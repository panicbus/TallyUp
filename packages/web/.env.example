VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional locally (defaults to http://localhost:3000). Required in
# production — the deployed Render URL, e.g. https://tallyup-api.onrender.com
VITE_API_URL=

# Optional everywhere. Leaving these blank turns analytics into a no-op,
# which is the normal state for local dev. Get a project key from
# posthog.com (free tier), Project Settings -> Project API Key.
# VITE_POSTHOG_HOST only needs setting if the project region isn't US
# (posthog.com defaults to https://us.i.posthog.com).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
